# Copy to .env (gitignored) and fill in ONLY the providers you actually use.
# NEVER commit real keys. The paid provider layer is optional and OFF by default;
# the whole MVP runs with none of these set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=

# Paid calls are opt-in. Uncomment to allow them after you've read docs/THREAT-MODEL.md:
# CTF_ALLOW_PAID=1
